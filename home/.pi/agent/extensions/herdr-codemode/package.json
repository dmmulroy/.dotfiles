{
  "name": "pi-herdr-codemode-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run test",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
