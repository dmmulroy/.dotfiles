# Platform detection. Runtime checks only: one stow tree for every OS, and each
# step or command branches on these values (darwin+brew, linux+apt|pacman).
__detect_os() {
    case "$(uname -s)" in
        Darwin) DOT_OS="darwin" ;;
        Linux) DOT_OS="linux" ;;
        *) DOT_OS="unknown" ;;
    esac

    DOT_PACKAGE_MANAGER="none"
    if [[ "$DOT_OS" == "darwin" ]]; then
        DOT_PACKAGE_MANAGER="brew"
    elif [[ "$DOT_OS" == "linux" && -r /etc/os-release ]]; then
        # Parse instead of sourcing: os-release sets VERSION, which dot marks readonly.
        local os_release_ids
        os_release_ids="$(awk -F= '$1 == "ID" || $1 == "ID_LIKE" { gsub(/"/, "", $2); printf "%s ", $2 }' /etc/os-release)"
        case " $os_release_ids " in
            *" debian "*|*" ubuntu "*) DOT_PACKAGE_MANAGER="apt" ;;
            *" arch "*|*" archlinux "*) DOT_PACKAGE_MANAGER="pacman" ;;
        esac
    fi
}
__detect_os
readonly DOT_OS DOT_PACKAGE_MANAGER

# Progress indicators
CURRENT_STEP=0
TOTAL_STEPS=0

# Helper functions
__print_header() {
    echo -e "\n${BOLD}${BLUE}==>${RESET} ${BOLD}$1${RESET}"
}

__print_success() {
    echo -e "${GREEN}✓${RESET} $1"
}

__print_error() {
    echo -e "${RED}✗${RESET} $1" >&2
}

__print_warning() {
    echo -e "${YELLOW}⚠${RESET} $1"
}

__print_info() {
    echo -e "${CYAN}ℹ${RESET} $1"
}

__print_step() {
    ((++CURRENT_STEP))
    echo -e "\n${BOLD}[${CURRENT_STEP}/${TOTAL_STEPS}]${RESET} $1"
}

__command_exists() {
    command -v "$1" >/dev/null 2>&1
}

__confirm() {
    local prompt="${1:-Continue?}"
    local default="${2:-n}"
    local response=""
    
    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n]: "
    else
        prompt="$prompt [y/N]: "
    fi
    
    # Headless runs (exe.dev first boot) and non-tty stdin take the default.
    if [[ "${DOT_HEADLESS:-false}" == "true" || ! -t 0 ]]; then
        __print_info "${prompt}${default} (non-interactive)"
        [[ "$default" == "y" ]]
        return
    fi

    read -r -p "$prompt" response
    
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        [nN][oO]|[nN]) return 1 ;;
        "")
            if [[ "$default" == "y" ]]; then
                return 0
            else
                return 1
            fi
            ;;
        *) return 1 ;;
    esac
}

__parse_brewfile_entry() {
    local line="$1"

    [[ "$line" =~ ^[[:space:]]*# ]] && return 1
    [[ -z "${line//[[:space:]]/}" ]] && return 1

    if [[ "$line" =~ ^[[:space:]]*brew[[:space:]]+\"([^\"]+)\" ]]; then
        printf 'brew\t%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi

    if [[ "$line" =~ ^[[:space:]]*cask[[:space:]]+\"([^\"]+)\" ]]; then
        printf 'cask\t%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi

    return 1
}

__brew_install() {
    local package_type="$1"
    local package_name="$2"

    case "$package_type" in
        brew) brew install "$package_name" ;;
        cask) brew install --cask "$package_name" ;;
        *)
            __print_error "Unsupported package type: $package_type"
            return 1
            ;;
    esac
}

__brew_upgrade() {
    local package_type="$1"
    local package_name="$2"

    case "$package_type" in
        brew) brew upgrade "$package_name" ;;
        cask) brew upgrade --cask "$package_name" ;;
        *)
            __print_error "Unsupported package type: $package_type"
            return 1
            ;;
    esac
}

__list_contains() {
    local needle="$1"
    local values="$2"
    grep -Fqx -- "$needle" <<< "$values"
}

__existing_github_private_key() {
    if [[ -f "$GITHUB_PRIVATE_KEY_PATH" ]]; then
        printf '%s\n' "$GITHUB_PRIVATE_KEY_PATH"
    elif [[ -f "$LEGACY_GITHUB_PRIVATE_KEY_PATH" ]]; then
        printf '%s\n' "$LEGACY_GITHUB_PRIVATE_KEY_PATH"
    else
        return 1
    fi
}

__save_failed_packages() {
    [[ $# -eq 0 ]] && return 0

    local failed_file
    failed_file="${PACKAGES_DIR}/failed_packages_$(date +%Y%m%d_%H%M%S)_$$.txt"
    printf '%s\n' "$@" | sort -u > "$failed_file"
    __print_info "Failed packages saved to: $failed_file"
}

__validate_work_brewfile() {
    local brewfile="$1"
    local line parsed package_type package_name

    while IFS= read -r line; do
        parsed=$(__parse_brewfile_entry "$line") || continue
        IFS=$'\t' read -r package_type package_name <<< "$parsed"
        if [[ "$package_type" == "cask" ]]; then
            __print_error "Work Brewfile contains cask '$package_name'; casks belong in packages/bundle"
            return 1
        fi
    done < "$brewfile"

    return 0
}

__require_no_args() {
    local command_name="$1"
    shift

    if [[ $# -gt 0 ]]; then
        __print_error "Unexpected argument for '$command_name': $1"
        __print_info "Run '${SCRIPT_NAME} ${command_name} --help' for usage"
        return 1
    fi
}

# ─── Tool Registry ────────────────────────────────────────────────────────────
# Each init step is registered once. Both cmd_init and cmd_doctor read from this.
#
# Fields (;; delimited):
#   name        – display name for step headers and doctor output
#   check       – command to test existence ("-" = not checked by doctor)
#   install     – named installer function ("fn:<function>")
#   required    – "true" = fatal on failure, "false" = warn and continue
#   skip_var    – variable that skips this step when "true" ("-" = never skip)
#   doctor      – "true" = include in doctor dev-tools check, "false" = skip
#   os          – "all", "darwin", or "linux"; other platforms skip the step
#
# Order matters: steps run top-to-bottom in cmd_init.
TOOL_REGISTRY=(
    "Homebrew          ;; brew ;; fn:__install_homebrew       ;; true  ;; -         ;; true  ;; darwin"
    "Brewfile packages ;; -    ;; fn:__install_packages       ;; true  ;; -         ;; false ;; darwin"
    "Linux packages    ;; -    ;; fn:__install_linux_packages ;; true  ;; -         ;; false ;; linux"
    "Linux extras      ;; -    ;; fn:__install_linux_extras   ;; false ;; -         ;; false ;; linux"
    "Stow dotfiles     ;; -    ;; fn:__stow_dotfiles          ;; true  ;; -         ;; false ;; all"
    "Bun               ;; bun  ;; fn:__install_bun            ;; true  ;; -         ;; true  ;; all"
    "Herdr plugins     ;; -    ;; fn:__sync_herdr_plugins     ;; true  ;; -         ;; false ;; all"
    "Rex               ;; -    ;; fn:__setup_rex              ;; false ;; -         ;; false ;; all"
    "Scroll Reverser   ;; -    ;; fn:__setup_scroll_reverser  ;; false ;; -         ;; false ;; darwin"
    "Vite+             ;; vp   ;; fn:__install_vite_plus      ;; true  ;; -         ;; true  ;; all"
    "pi                ;; pi   ;; fn:__install_pi             ;; true  ;; -         ;; true  ;; all"
    "Claude Code       ;; claude ;; fn:__install_claude_code  ;; false ;; -         ;; true  ;; all"
    "pi-claude-cli     ;; -    ;; fn:__install_pi_claude_cli  ;; false ;; -         ;; false ;; all"
    "SSH key           ;; -    ;; fn:__generate_ssh_key       ;; false ;; SKIP_SSH  ;; false ;; all"
    "MonoLisa font     ;; -    ;; fn:__install_font           ;; false ;; SKIP_FONT ;; false ;; all"
    "Fish shell        ;; -    ;; fn:__setup_fish_shell       ;; false ;; -         ;; false ;; all"
)

# Parse a registry entry into variables: r_name, r_check, r_install, r_required, r_skip, r_doctor
__parse_tool_entry() {
    local entry="$1"
    r_name="$(    echo "$entry" | awk -F';;' '{print $1}' | xargs)"
    r_check="$(   echo "$entry" | awk -F';;' '{print $2}' | xargs)"
    r_install="$( echo "$entry" | awk -F';;' '{print $3}' | xargs)"
    r_required="$(echo "$entry" | awk -F';;' '{print $4}' | xargs)"
    r_skip="$(    echo "$entry" | awk -F';;' '{print $5}' | xargs)"
    r_doctor="$(  echo "$entry" | awk -F';;' '{print $6}' | xargs)"
    r_os="$(      echo "$entry" | awk -F';;' '{print $7}' | xargs)"
}

# True when the parsed registry entry (r_os, r_skip) should run on this machine.
__registry_entry_applies() {
    [[ "$r_os" == "all" || "$r_os" == "$DOT_OS" ]] || return 1
    if [[ "$r_skip" != "-" ]] && [[ "${!r_skip:-}" == "true" ]]; then
        return 1
    fi
}

# Run all registered init steps
__run_init_steps() {
    # Count non-skipped steps
    TOTAL_STEPS=0
    for entry in "${TOOL_REGISTRY[@]}"; do
        __parse_tool_entry "$entry"
        __registry_entry_applies || continue
        ((++TOTAL_STEPS))
    done
    CURRENT_STEP=0

    for entry in "${TOOL_REGISTRY[@]}"; do
        __parse_tool_entry "$entry"
        __registry_entry_applies || continue

        __print_step "$r_name"

        if [[ "$r_install" != fn:* ]]; then
            __print_error "Invalid installer registered for $r_name"
            return 1
        fi

        local fn="${r_install#fn:}"
        if "$fn"; then
            true  # function handles its own messaging
        elif [[ "$r_required" == "true" ]]; then
            return 1
        else
            __print_warning "$r_name failed (continuing)"
        fi
    done
}

# ─── Installation Functions ───────────────────────────────────────────────────
# Custom installers called via "fn:" entries. These handle their own idempotency
# and messaging (except the step header, which the registry loop prints).

__install_homebrew() {
    if __command_exists brew; then
        __print_success "Homebrew is already installed"
        return 0
    fi
    
    __print_info "Homebrew is not installed. Installing now..."
    
    # Create temporary log file for installation output
    local log_file
    log_file=$(mktemp)
    local exit_code=0
    
    __print_info "Running Homebrew installer (non-interactive mode)..."
    
    # Run installer with non-interactive flag and capture output
    if NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" > "$log_file" 2>&1; then
        __print_success "Homebrew installation successful"
        
        # Configure Homebrew environment for the current session
        __print_info "Configuring Homebrew environment..."
        if [[ "$(uname -m)" == "arm64" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        else
            eval "$(/usr/local/bin/brew shellenv)"
        fi
        __print_success "Homebrew environment configured"
    else
        exit_code=$?
        __print_error "Homebrew installation failed (exit code: $exit_code)"
        
        # Surface errors from the log
        __print_info "Installation output:"
        if [[ -s "$log_file" ]]; then
            # Show last 20 lines of output for context
            tail -20 "$log_file" | while IFS= read -r line; do
                echo "  $line"
            done
        else
            __print_warning "No installation output captured"
        fi
        
        # Common troubleshooting hints
        __print_info "Troubleshooting:"
        __print_info "  - Check if you have sufficient disk space"
        __print_info "  - Ensure you have admin privileges"
        __print_info "  - Check network connectivity"
        __print_info "  - Try running manually: /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
        
        rm "$log_file"
        return 1
    fi
    
    # Cleanup log file
    rm "$log_file"
}

__install_bun() {
    if __command_exists bun; then
        __print_success "Bun is already installed"
        return 0
    fi

    __print_info "Installing Bun..."
    if curl -fsSL https://bun.sh/install | bash; then
        # Later steps in this run need it before a new shell picks up PATH.
        export PATH="${HOME}/.bun/bin:${PATH}"
        __print_success "Bun installed successfully"
    else
        __print_error "Failed to install Bun"
        return 1
    fi
}

__install_vite_plus() {
    if __command_exists vp; then
        __print_success "Vite+ is already installed"
        return 0
    fi

    __print_info "Installing Vite+..."
    # Without VP_SELF_SETUP_NO_MODIFY_PATH the installer overwrites the stowed
    # conf.d/vite-plus.fish (writing into this repo) and edits ~/.bashrc/.profile.
    if curl -fsSL https://vite.plus | VP_SELF_SETUP_NO_MODIFY_PATH=1 bash; then
        # __install_pi runs `vp` in this same process. macOS installs to
        # ~/.vite-plus, Linux to the XDG data dir.
        export PATH="${HOME}/.vite-plus/bin:${XDG_DATA_HOME:-${HOME}/.local/share}/vite-plus/bin:${PATH}"
        __print_success "Vite+ installed successfully"
    else
        __print_error "Failed to install Vite+"
        return 1
    fi
}

__sync_herdr_plugins() {
    if ! __command_exists herdr; then
        __print_error "Herdr is not installed"
        return 1
    fi

    if [[ ! -f "$HERDR_PLUGIN_SOURCES_FILE" ]]; then
        __print_error "Herdr plugin source list not found: $HERDR_PLUGIN_SOURCES_FILE"
        return 1
    fi

    local plugin_source
    local failed_plugins=()

    __print_info "Installing and updating Herdr plugins..."
    while IFS= read -r plugin_source || [[ -n "$plugin_source" ]]; do
        plugin_source="${plugin_source%%#*}"
        plugin_source="${plugin_source//[[:space:]]/}"
        [[ -z "$plugin_source" ]] && continue

        __print_info "Syncing Herdr plugin: $plugin_source"
        if herdr plugin install "$plugin_source" --yes; then
            __print_success "Herdr plugin synced: $plugin_source"
        else
            failed_plugins+=("$plugin_source")
        fi
    done < "$HERDR_PLUGIN_SOURCES_FILE"

    if [[ ${#failed_plugins[@]} -gt 0 ]]; then
        __print_error "Failed to sync Herdr plugins: ${failed_plugins[*]}"
        return 1
    fi

    if herdr status server >/dev/null 2>&1; then
        herdr server reload-config >/dev/null
    fi

    __print_success "Herdr plugins are up to date"
}

# Print the rex CLI path: $REX_BIN_DIR inside Rex terminals, then PATH, then
# the copy bundled with the app's server.
__rex_cli() {
    if [[ -n "${REX_BIN_DIR:-}" && -x "${REX_BIN_DIR}/rex" ]]; then
        echo "${REX_BIN_DIR}/rex"
    elif [[ -x "$REX_BUNDLED_CLI" ]]; then
        echo "$REX_BUNDLED_CLI"
    elif __command_exists rex && rex version 2>/dev/null | grep -q '^rex 0\.'; then
        command -v rex
    else
        return 1
    fi
}

__rex_installed_build() {
    defaults read "${REX_APP_PATH}/Contents/Info" CFBundleVersion 2>/dev/null
}

# Print "<build> <dmg-url>" for the newest appcast entry.
__rex_latest_release() {
    local appcast
    appcast="$(curl -fsSL "$REX_APPCAST_URL")" || return 1
    awk '
        /<sparkle:version>/ { gsub(/.*<sparkle:version>|<\/sparkle:version>.*/, ""); build = $0 }
        /<enclosure / && build != "" {
            match($0, /url="[^"]+"/)
            url = substr($0, RSTART + 5, RLENGTH - 6)
            if (best == "" || build + 0 > best + 0) { best = build; best_url = url }
            build = ""
        }
        END { if (best != "") print best, best_url }
    ' <<< "$appcast"
}

# Install Rex from a DMG after checking its Developer ID team. Only used when
# the app is not running; a running app updates through Sparkle instead.
__install_rex_dmg() {
    local url="$1"
    local work mount app
    work="$(mktemp -d)" || return 1
    mount="${work}/mount"

    __print_info "Downloading ${url##*/}..."
    if ! curl -fL --progress-bar -o "${work}/rex.dmg" "$url"; then
        rm -rf "$work"
        return 1
    fi
    if ! hdiutil attach -nobrowse -readonly -quiet -mountpoint "$mount" "${work}/rex.dmg"; then
        rm -rf "$work"
        return 1
    fi

    app="$(find "$mount" -maxdepth 1 -name '*.app' -print -quit)"
    local status=1
    if [[ -z "$app" ]]; then
        __print_error "No app found in the Rex disk image"
    elif ! codesign --verify --deep --strict "$app" 2>/dev/null \
        || ! codesign -dv "$app" 2>&1 | grep -q "^TeamIdentifier=${REX_TEAM_ID}$"; then
        __print_error "Rex disk image failed signature verification; not installing"
    elif ditto "$app" "${REX_APP_PATH}.new" \
        && rm -rf "$REX_APP_PATH" \
        && mv "${REX_APP_PATH}.new" "$REX_APP_PATH"; then
        status=0
    fi

    hdiutil detach -quiet "$mount" || true
    rm -rf "$work" "${REX_APP_PATH}.new"
    return "$status"
}

# Install Rex if missing, or update it when the appcast has a newer build.
__update_rex_app() {
    local release latest url installed
    if ! release="$(__rex_latest_release)" || [[ -z "$release" ]]; then
        __print_warning "Could not read the Rex appcast; skipping Rex update"
        return 1
    fi
    read -r latest url <<< "$release"
    installed="$(__rex_installed_build || true)"

    if [[ -n "$installed" && "$installed" -ge "$latest" ]]; then
        __print_success "Rex is up to date (build ${installed})"
        return 0
    fi

    if [[ -n "$installed" ]] && pgrep -qf "${REX_APP_PATH}/Contents/MacOS/"; then
        # Replacing a running app bundle is unsafe; let Sparkle do it. The app
        # relaunches, and sessions survive because they live in the server.
        __print_info "Rex build ${latest} is available (installed: ${installed}); asking the app to install it..."
        local rex_bin
        if rex_bin="$(__rex_cli)" && "$rex_bin" do client.update.accept >/dev/null 2>&1; then
            __print_success "Rex is installing build ${latest} and will relaunch"
        else
            __print_warning "Rex could not start the update; use Rex > Install Update, or quit Rex and rerun '${SCRIPT_NAME} update'"
        fi
        return 0
    fi

    __print_info "Installing Rex build ${latest}..."
    if __install_rex_dmg "$url"; then
        __print_success "Rex build ${latest} installed"
    else
        __print_error "Failed to install Rex"
        return 1
    fi
}

# Validate the stowed config and, when a server is running, reload it.
__reload_rex_config() {
    local rex_bin
    if ! rex_bin="$(__rex_cli)"; then
        __print_warning "rex CLI not found (launch Rex once to install its server); skipping config reload"
        return 0
    fi
    if ! "$rex_bin" config check >/dev/null; then
        __print_error "Rex config has errors; run 'rex config check'"
        return 1
    fi
    if "$rex_bin" --autostart=false server status >/dev/null 2>&1; then
        "$rex_bin" --autostart=false config reload >/dev/null && __print_success "Rex config reloaded"
    else
        __print_success "Rex config is valid"
    fi
}

# Write the Rex app settings tracked in macos-defaults.conf. Rex reads most of
# them only at launch, so a running app needs a relaunch to show changes.
__apply_rex_app_settings() {
    if [[ ! -f "$REX_APP_SETTINGS_FILE" ]]; then
        __print_warning "Rex app settings file not found: ${REX_APP_SETTINGS_FILE}"
        return 0
    fi

    local key type value current expected changed=0
    while read -r key type value; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        current="$(defaults read "$REX_DEFAULTS_DOMAIN" "$key" 2>/dev/null || true)"
        expected="$value"
        if [[ "$type" == "bool" ]]; then
            [[ "$value" == "true" ]] && expected="1" || expected="0"
        fi
        [[ "$current" == "$expected" ]] && continue
        if defaults write "$REX_DEFAULTS_DOMAIN" "$key" "-${type}" "$value"; then
            changed=$((changed + 1))
        else
            __print_error "Failed to write Rex setting ${key}"
            return 1
        fi
    done < "$REX_APP_SETTINGS_FILE"

    if (( changed == 0 )); then
        __print_success "Rex app settings are up to date"
    elif pgrep -qf "${REX_APP_PATH}/Contents/MacOS/"; then
        __print_success "Wrote ${changed} Rex app setting(s); relaunch Rex to apply them"
    else
        __print_success "Wrote ${changed} Rex app setting(s)"
    fi
}

# True when the tracked theme is among the app's imported custom themes.
__rex_theme_imported() {
    defaults export "$REX_DEFAULTS_DOMAIN" - 2>/dev/null \
        | plutil -convert xml1 -o - - 2>/dev/null \
        | awk '/<key>Workspace.customThemes<\/key>/{f=1; next} f&&/<\/data>/{exit} f&&!/<data>/{print}' \
        | base64 -D 2>/dev/null \
        | grep -q "\"name\":\"${REX_THEME_NAME}\""
}

# Import the tracked theme through the init.lua action when the app lacks it.
# Needs a running app with Remote Control on (set by macos-defaults.conf).
__import_rex_theme() {
    if __rex_theme_imported; then
        __print_success "Rex theme ${REX_THEME_NAME} is imported"
        return 0
    fi
    local rex_bin
    if ! pgrep -qf "${REX_APP_PATH}/Contents/MacOS/" || ! rex_bin="$(__rex_cli)"; then
        __print_warning "Rex is not running; launch it and rerun '${SCRIPT_NAME} update' to import the ${REX_THEME_NAME} theme"
        return 0
    fi
    if "$rex_bin" do "$REX_THEME_IMPORT_ACTION" >/dev/null 2>&1; then
        __print_success "Imported Rex theme ${REX_THEME_NAME}"
    else
        __print_warning "Could not import the Rex theme; run 'Import Catppuccin Macchiato Theme' from the Rex palette"
    fi
}

# Install Rex's xterm-rex terminfo entry (~/.terminfo) and its ssh guard
# (~/.config/rex/ssh_config + an Include in ~/.ssh/config, so remote hosts get
# xterm-256color). Both hold machine paths, so Rex writes them, not stow.
__setup_rex_terminfo() {
    local rex_cli
    rex_cli="$(__rex_cli)" || {
        __print_warning "rex CLI not found; skipping Rex terminfo setup"
        return 0
    }
    if "$rex_cli" terminfo status 2>/dev/null | grep -q '^Ready:'; then
        __print_success "Rex terminfo is set up"
    elif "$rex_cli" terminfo setup >/dev/null; then
        __print_success "Installed Rex terminfo (xterm-rex) and ssh guard"
    else
        __print_error "rex terminfo setup failed"
        return 1
    fi
}

# Rex agent skill + hooks. The shared skill (~/.agents/skills/rex) is tracked
# in home/.agents/skills/rex; setup refreshes it through the stow symlink and
# adds hooks to Claude Code / Codex settings.
__setup_rex_agents() {
    local rex_cli
    rex_cli="$(__rex_cli)" || return 0
    if "$rex_cli" skill setup >/dev/null; then
        __print_success "Rex agent skill and hooks are set up"
    else
        __print_warning "rex skill setup failed; run it by hand to see why"
    fi
}

# luarocks for Rex's tree: Lua 5.1 (LuaJIT from Homebrew), never the system tree.
__rex_luarocks() {
    local server_args=()
    if [[ -n "${REX_LUA_ROCKS_SERVER:-}" ]]; then
        server_args=(--server "$REX_LUA_ROCKS_SERVER")
    fi
    luarocks --lua-version 5.1 --tree "$REX_LUA_ROCKS_TREE" ${server_args[@]+"${server_args[@]}"} "$@"
}

# Install or upgrade the Rex config's rocks (twitch-lua and what it depends on).
# `luarocks install` keeps an installed rock unless a newer version is published.
# Failures only warn: the config skips twitch-lua (falls back to twt) without it.
__install_rex_lua_rocks() {
    if ! __command_exists luarocks; then
        __print_warning "luarocks not found (brew \"luarocks\" in packages/bundle); skipping Rex Lua rocks"
        return 0
    fi
    local rock failed=0
    for rock in "${REX_LUA_ROCKS[@]}"; do
        if __rex_luarocks install "$rock" >/dev/null 2>&1; then
            __print_success "Rex Lua rock ${rock} is installed ($(__rex_luarocks show --mversion "$rock" 2>/dev/null))"
        else
            __print_warning "Could not install Rex Lua rock ${rock}; run: luarocks --lua-version 5.1 --tree ${REX_LUA_ROCKS_TREE} install ${rock}"
            failed=1
        fi
    done
    return "$failed"
}

# Install (or upgrade) Rex's Linux server package. Ubuntu also has an unrelated
# "rex" package, so a rex that is not "rex 0.x" counts as missing.
__install_rex_linux() {
    local mode="${1:-install}"
    if [[ "$mode" != "update" ]] && __command_exists rex && rex version 2>/dev/null | grep -q '^rex 0\.'; then
        __print_success "Rex is installed ($(rex version | head -1))"
        return 0
    fi
    __print_info "Installing Rex from the ${REX_LINUX_CHANNEL} channel..."
    if curl -fsSL "$REX_LINUX_INSTALL_URL" | sh -s -- --channel "$REX_LINUX_CHANNEL"; then
        hash -r
        __print_success "Rex installed ($(rex version | head -1))"
    else
        __print_error "Failed to install Rex"
        return 1
    fi
}

# exe.dev SSH sessions may lack XDG_RUNTIME_DIR, which rex and systemctl --user need.
__export_rex_runtime_dir() {
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi
}

# Personal Rex server (systemd user units, socket-activated) running as this
# account; this is the server Rex for Mac finds over ssh://<host>.
__setup_rex_server_linux() {
    if ! __command_exists systemctl || [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        __print_warning "No systemd user session; skipping Rex server (run 'rex server install' later)"
        return 0
    fi
    if systemctl --user is-enabled rex.socket >/dev/null 2>&1; then
        __print_success "Rex server is installed (rex.socket)"
    elif rex server install >/dev/null; then
        __print_success "Rex server installed; it starts at boot and on the first rex command"
    else
        __print_warning "rex server install failed; run it by hand to see why"
    fi
}

__setup_rex_linux() {
    __install_rex_linux || return 1
    __export_rex_runtime_dir
    __setup_rex_server_linux
    __reload_rex_config
    __setup_rex_terminfo
    __setup_rex_agents
}

__setup_rex() {
    if [[ "$DOT_OS" == "linux" ]]; then
        __setup_rex_linux
        return
    fi
    __update_rex_app || return 1
    __apply_rex_app_settings
    __install_rex_lua_rocks || true
    __reload_rex_config
    __import_rex_theme
    __setup_rex_terminfo
    __setup_rex_agents
}

# Scroll direction: natural on the trackpad, traditional on the mouse.
# macOS has one global "natural scrolling" switch, so keep it on and let
# Scroll Reverser (cask in packages/bundle) flip only mouse wheel events.
readonly SCROLL_REVERSER_DOMAIN="com.pilotmoon.scroll-reverser"
readonly SCROLL_REVERSER_APP="/Applications/Scroll Reverser.app"

__setup_scroll_reverser() {
    if [[ ! -d "$SCROLL_REVERSER_APP" ]]; then
        __print_warning "Scroll Reverser not installed; skipping (brew install --cask scroll-reverser)"
        return 0
    fi

    # Global natural scrolling on (trackpad stays natural).
    defaults write -g com.apple.swipescrolldirection -bool true

    local key value
    while read -r key value; do
        defaults write "$SCROLL_REVERSER_DOMAIN" "$key" -bool "$value"
    done <<'SETTINGS'
InvertScrollingOn true
ReverseMouse true
ReverseTrackpad false
ReverseTablet false
ReverseY true
ReverseX false
StartAtLogin true
SETTINGS

    # Scroll Reverser reads prefs at launch; restart it to apply.
    if pgrep -xq "Scroll Reverser"; then
        osascript -e 'quit app "Scroll Reverser"' >/dev/null 2>&1 || true
        sleep 1
    fi
    open -g "$SCROLL_REVERSER_APP" || true
    __print_success "Scroll Reverser configured (trackpad natural, mouse traditional)"
    __print_info "Grant Scroll Reverser Accessibility access in System Settings > Privacy & Security if prompted"
}

