            ;;
        link)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} link\n\nCreate a global symlink for dot."
            ;;
        unlink)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} unlink\n\nRemove global dot symlinks."
            ;;
        edit)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} edit\n\nOpen the dotfiles repository in \$EDITOR."
            ;;
        help)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} help [COMMAND]"
            ;;
        *)
            __print_error "Unknown command: $command_name"
            return 1
            ;;
    esac
}

