    else
        __print_warning "pi is not installed; skipping pi update"
    fi
}

cmd_doctor() {
    __require_no_args doctor "$@" || return 1
    __print_header "Running diagnostics"
    
    local issues=0
    
    # Check Homebrew
    if __command_exists brew; then
        __print_success "Homebrew installed"
    else
        __print_error "Homebrew not installed"
        ((++issues))
    fi
    
    # Check Stow
    if __command_exists stow; then
        __print_success "GNU Stow installed"
    else
        __print_error "GNU Stow not installed"
        ((++issues))
    fi
    
    # Check Fish
    if __command_exists fish; then
        __print_success "Fish shell installed"
        if [[ "$SHELL" == "$(command -v fish)" ]]; then
            __print_success "Fish is default shell"
        else
            __print_warning "Fish is not default shell"
        fi
    else
        __print_error "Fish shell not installed"
        ((++issues))
    fi
    
    # Check symlinks
    local broken_links=0
    while IFS= read -r -d '' link; do
        if [[ ! -e "$link" ]]; then
            ((++broken_links))
        fi
    done < <(find "${HOME}" -maxdepth 3 -type l -print0 2>/dev/null)
    
    if [[ $broken_links -eq 0 ]]; then
        __print_success "No broken symlinks found"
    else
        __print_warning "Found $broken_links broken symlinks"
    fi
    
    # Check SSH key
    local github_private_key
    if github_private_key=$(__existing_github_private_key); then
        __print_success "GitHub SSH private key exists at $github_private_key"
        if [[ "$github_private_key" == "$LEGACY_GITHUB_PRIVATE_KEY_PATH" ]]; then
            __print_warning "Legacy key name detected; migrate it to $GITHUB_PRIVATE_KEY_PATH"
        fi
        if [[ ! -f "${github_private_key}.pub" ]]; then
            __print_warning "GitHub SSH public key not found at ${github_private_key}.pub"
        fi
    else
        __print_warning "GitHub SSH key not found"
    fi
    
    # Check key development tools (from registry + extras installed via brew)
    local missing_tools=()

    # Tools from the registry (doctor=true entries)
    for entry in "${TOOL_REGISTRY[@]}"; do
        __parse_tool_entry "$entry"
        [[ "$r_doctor" != "true" ]] && continue
        if __command_exists "$r_check"; then
            __print_success "$r_check is available"
        else
            missing_tools+=("$r_check")
        fi
    done

    # Additional tools managed outside the registry (brew packages, etc.)
    local extra_tools=("git" "herdr" "nvim" "node" "npm")
    for tool in "${extra_tools[@]}"; do
        if __command_exists "$tool"; then
            __print_success "$tool is available"
        else
            missing_tools+=("$tool")
        fi
    done
    
    if [[ ${#missing_tools[@]} -gt 0 ]]; then
        __print_warning "Missing development tools: ${missing_tools[*]}"
    fi
    
    # Check if Fish plugins are installed (Fisher)
    if __command_exists fish && fish -c "type fisher" >/dev/null 2>&1; then
        __print_success "Fisher (Fish plugin manager) is available"
    elif __command_exists fish; then
        __print_warning "Fisher not installed - Fish plugins may not work"
    fi
    
    # Check if dotfiles directory is in PATH
    if echo "$PATH" | grep -q "$DOTFILES_DIR"; then
        __print_success "Dotfiles directory is in PATH"
    else
        __print_warning "Dotfiles directory not in PATH - 'dot' command may not work globally"
        if [[ "$SHELL" == *"fish"* ]]; then
            __print_info "Run 'source ~/.config/fish/config.fish' or restart shell to fix"
        else
            __print_info "Add 'export PATH=\"$DOTFILES_DIR:\$PATH\"' to your shell profile"
        fi
    fi
    
    if [[ $issues -eq 0 ]]; then
        __print_header "All critical checks passed! ✨"
        if [[ ${#missing_tools[@]} -gt 0 ]]; then
            __print_info "Note: Some optional tools are missing but core functionality is intact"
        fi
    else
        __print_header "Found $issues critical issues"
    fi
}

