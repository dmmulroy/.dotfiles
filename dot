cmd_benchmark_shell() {
    __print_header "Benchmarking Fish shell startup performance"
    
    # Check if Fish is installed
    if ! __command_exists fish; then
        __print_error "Fish shell is not installed"
        __print_info "Install Fish shell first: brew install fish"
        return 1
    fi
    
    # Parse options
    local runs=10
    local verbose=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--runs)
                runs="$2"
                shift 2
                ;;
            -v|--verbose)
                verbose=true
                shift
                ;;
            -h|--help)
                cat << EOF
${BOLD}USAGE:${RESET}
    ${SCRIPT_NAME} benchmark-shell [OPTIONS]

${BOLD}OPTIONS:${RESET}
    -r, --runs NUM      Number of benchmark runs (default: 10)
    -v, --verbose       Show detailed timing for each run
    -h, --help          Show this help

${BOLD}EXAMPLES:${RESET}
    ${SCRIPT_NAME} benchmark-shell              # Run 10 benchmarks
    ${SCRIPT_NAME} benchmark-shell -r 20        # Run 20 benchmarks
    ${SCRIPT_NAME} benchmark-shell -v           # Show verbose output

EOF
                return 0
                ;;
            *)
                __print_error "Unknown option: $1"
                __print_info "Run '${SCRIPT_NAME} benchmark-shell --help' for usage"
                return 1
                ;;
        esac
    done
    
    # Validate number of runs
    if ! [[ "$runs" =~ ^[0-9]+$ ]] || [[ "$runs" -lt 1 ]] || [[ "$runs" -gt 100 ]]; then
        __print_error "Number of runs must be between 1 and 100"
        return 1
    fi
    
    __print_info "Running $runs Fish shell startup benchmarks..."
    
    # Create temporary script that exits immediately
    local temp_script
    temp_script=$(mktemp -t DOT_fish_benchmark_XXXXXX.fish)
    if [[ -z "$temp_script" ]]; then
        __print_error "Failed to create temp file"
        return 1
    fi
    # Clean up on return and immediately remove this function-local trap. If
    # the trap survives until main returns, nounset expands an out-of-scope
    # temp_script variable and turns a successful benchmark into an error.
    trap 'rm -f "$temp_script"; trap - RETURN' RETURN
    echo "exit 0" > "$temp_script"
    
    # Array to store timing results
    local times=()
    local total_time=0
    
    # Run benchmarks using a more sophisticated approach
    for i in $(seq 1 "$runs"); do
        if [[ "$verbose" == true ]]; then
            __print_info "Run $i/$runs..."
        fi
        
        # Use python for high-precision timing if available, otherwise use perl
        local elapsed
        if command -v python3 >/dev/null 2>&1; then
            elapsed=$(python3 -c "
import time
import subprocess
import sys
start = time.time()
try:
    subprocess.run(['fish', '$temp_script'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    end = time.time()
    print(f'{end - start:.3f}')
except:
    print('0.001')
")
        elif command -v perl >/dev/null 2>&1; then
            elapsed=$(perl -e "
use Time::HiRes 'time';
my \$start = time();
system('fish', '$temp_script', '>/dev/null', '2>&1');
my \$end = time();
printf '%.3f', \$end - \$start;
")
        else
            # Fallback to basic approach
            SECONDS=0
            fish "$temp_script" >/dev/null 2>&1
            elapsed="$SECONDS"
            if [[ "$elapsed" == "0" ]]; then
                elapsed="0.001"
            fi
        fi
        
        # Ensure elapsed is a valid number
        if [[ -z "$elapsed" ]] || ! [[ "$elapsed" =~ ^[0-9]*\.?[0-9]+$ ]]; then
            elapsed="0.001"
        fi
        
        times+=("$elapsed")
        if command -v bc >/dev/null 2>&1; then
            total_time=$(echo "$total_time + $elapsed" | bc -l)
        else
            total_time=$(echo "$total_time $elapsed" | awk '{print $1 + $2}')
        fi
        
        if [[ "$verbose" == true ]]; then
            printf "  Run %2d: %.3f seconds\n" "$i" "$elapsed"
        fi
    done
    
    # Calculate statistics
    local avg_time
    if command -v bc >/dev/null 2>&1; then
        avg_time=$(echo "scale=3; $total_time / $runs" | bc -l)
    else
        avg_time=$(echo "$total_time $runs" | awk '{printf "%.3f", $1/$2}')
    fi
    
    # Find min and max times
    local min_time="${times[0]}"
    local max_time="${times[0]}"
    
    for time in "${times[@]}"; do
        if command -v bc >/dev/null 2>&1; then
            if (( $(echo "$time < $min_time" | bc -l) )); then
                min_time="$time"
            fi
            if (( $(echo "$time > $max_time" | bc -l) )); then
                max_time="$time"
            fi
        else
            # Fallback for systems without bc
            if [[ $(echo "$time $min_time" | awk '{print ($1 < $2)}') == 1 ]]; then
                min_time="$time"
            fi
            if [[ $(echo "$time $max_time" | awk '{print ($1 > $2)}') == 1 ]]; then
                max_time="$time"
            fi
        fi
    done
    
    # Generate custom report
    __print_header "Fish Shell Startup Benchmark Results"
    echo ""
    echo -e "${BOLD}Configuration:${RESET}"
    echo "  Shell: $(fish --version)"
    echo "  Runs: $runs"
    echo "  Test: Empty script execution"
    echo ""
    
    echo -e "${BOLD}Performance Results:${RESET}"
    printf "  Average time: ${GREEN}%.3f${RESET} seconds\n" "$avg_time"
    printf "  Fastest time: ${GREEN}%.3f${RESET} seconds\n" "$min_time"
    printf "  Slowest time: ${YELLOW}%.3f${RESET} seconds\n" "$max_time"
    
    if command -v bc >/dev/null 2>&1; then
        local range
        range=$(echo "scale=3; $max_time - $min_time" | bc -l)
        printf "  Time range:   ${CYAN}%.3f${RESET} seconds\n" "$range"
    fi
    
    echo ""
    echo -e "${BOLD}Performance Assessment:${RESET}"
    
    # Performance thresholds (in seconds)
    local excellent=0.050
    local good=0.100
    local fair=0.200
    
    if command -v bc >/dev/null 2>&1; then
        if (( $(echo "$avg_time <= $excellent" | bc -l) )); then
            __print_success "Excellent startup performance! (≤50ms)"
        elif (( $(echo "$avg_time <= $good" | bc -l) )); then
            __print_success "Good startup performance (≤100ms)"
        elif (( $(echo "$avg_time <= $fair" | bc -l) )); then
            __print_warning "Fair startup performance (≤200ms)"
        else
            __print_warning "Slow startup performance (>200ms)"
            echo ""
            __print_info "Tips to improve Fish shell startup time:"
            __print_info "  - Review Fish config.fish for expensive operations"
            __print_info "  - Consider lazy-loading plugins and functions"
            __print_info "  - Check for slow network operations in startup scripts"
            __print_info "  - Use 'fish --profile-startup /tmp/fish-startup.profile -ic exit' to identify startup bottlenecks"
        fi
    else
        # Fallback assessment without bc
        if [[ $(echo "$avg_time 0.050" | awk '{print ($1 <= $2)}') == 1 ]]; then
            __print_success "Excellent startup performance! (≤50ms)"
        elif [[ $(echo "$avg_time 0.100" | awk '{print ($1 <= $2)}') == 1 ]]; then
            __print_success "Good startup performance (≤100ms)"
        elif [[ $(echo "$avg_time 0.200" | awk '{print ($1 <= $2)}') == 1 ]]; then
            __print_warning "Fair startup performance (≤200ms)"
        else
            __print_warning "Slow startup performance (>200ms)"
        fi
    fi
    
    echo ""
    __print_info "To profile Fish startup in detail, run: fish --profile-startup /tmp/fish-startup.profile -ic exit"
    __print_info "Then inspect the slowest commands: sort -nr /tmp/fish-startup.profile | head -20"
    __print_info "Fish config location: ~/.config/fish/config.fish"
}

cmd_retry_failed() {
    __require_no_args retry-failed "$@" || return 1
    __print_header "Retrying failed package installations"

    local failed_files=()
    local failed_file
    while IFS= read -r failed_file; do
        failed_files+=("$failed_file")
    done < <(find "${PACKAGES_DIR}" -name "failed_packages_*.txt" -type f 2>/dev/null | sort)

    if [[ ${#failed_files[@]} -eq 0 ]]; then
        __print_info "No failed packages file found"
        return 0
    fi

    local pending_file
    pending_file=$(mktemp)
    for failed_file in "${failed_files[@]}"; do
        cat "$failed_file" >> "$pending_file"
    done
    sort -u -o "$pending_file" "$pending_file"

    __print_info "Found ${#failed_files[@]} failed package file(s)"
    __print_info "Attempting to retry installation..."

    local retry_count=0
    local success_count=0
    local remaining_packages=()
    local package_info package_type package_name

    while IFS= read -r package_info; do
        [[ -z "$package_info" ]] && continue
        ((++retry_count))

        if [[ ! "$package_info" =~ ^(brew|cask):(.+)$ ]]; then
            __print_warning "Unrecognized failed package entry: $package_info"
            remaining_packages+=("$package_info")
            continue
        fi

        package_type="${BASH_REMATCH[1]}"
        package_name="${BASH_REMATCH[2]}"
        __print_info "Retrying $package_type package: $package_name"

        if __brew_install "$package_type" "$package_name" 2>/dev/null; then
            __print_success "Successfully installed: $package_name"
            ((++success_count))
        else
            __print_warning "Still failing: $package_name"
            remaining_packages+=("$package_info")
        fi
    done < "$pending_file"

    rm -f "$pending_file"
    __print_info "Retry complete: $success_count/$retry_count packages installed"

    if [[ ${#remaining_packages[@]} -eq 0 ]]; then
        rm -f "${failed_files[@]}"
        __print_success "All failed packages now installed!"
        return 0
    fi

    __save_failed_packages "${remaining_packages[@]}"
    rm -f "${failed_files[@]}"
    __print_error "${#remaining_packages[@]} package(s) still failed to install"
    return 1
}

cmd_check_packages() {
    __require_no_args check-packages "$@" || return 1
    __print_header "Checking installed packages"
    
    local missing_brew=()
    local missing_cask=()
    local installed_brew=()
    local installed_cask=()
    
    # Get lists of installed packages once to avoid repeated calls
    local installed_formulas
    local installed_casks
    if ! installed_formulas=$(brew list --formula 2>/dev/null); then
        __print_error "Failed to list installed Homebrew formulas"
        return 1
    fi
    if ! installed_casks=$(brew list --cask 2>/dev/null); then
        __print_error "Failed to list installed Homebrew casks"
        return 1
    fi

    # Check base packages
    if [[ -f "${PACKAGES_DIR}/bundle" ]]; then
        __print_info "Checking base packages..."
        
        local line parsed package_type package_name
        while IFS= read -r line; do
            parsed=$(__parse_brewfile_entry "$line") || continue
            IFS=$'\t' read -r package_type package_name <<< "$parsed"

            if [[ "$package_type" == "brew" ]]; then
                if __list_contains "$package_name" "$installed_formulas"; then
                    installed_brew+=("$package_name")
                else
                    missing_brew+=("$package_name")
                fi
            elif __list_contains "$package_name" "$installed_casks"; then
                installed_cask+=("$package_name")
            else
                missing_cask+=("$package_name")
            fi
        done < "${PACKAGES_DIR}/bundle"
    fi
    
    # Check work packages
    if [[ -f "${PACKAGES_DIR}/bundle.work" ]]; then
        __print_info "Checking work packages..."
        
        __validate_work_brewfile "${PACKAGES_DIR}/bundle.work" || return 1
        local line parsed package_type package_name
        while IFS= read -r line; do
            parsed=$(__parse_brewfile_entry "$line") || continue
            IFS=$'\t' read -r package_type package_name <<< "$parsed"

            if __list_contains "$package_name" "$installed_formulas"; then
                installed_brew+=("$package_name (work)")
            else
                missing_brew+=("$package_name (work)")
            fi
        done < "${PACKAGES_DIR}/bundle.work"
    fi
    
    # Report results
    __print_header "Package Status Report"
    
    echo -e "\n${BOLD}Installed Packages:${RESET}"
    __print_success "Brew formulas: ${#installed_brew[@]}"
    __print_success "Casks: ${#installed_cask[@]}"
    
    if [[ ${#missing_brew[@]} -gt 0 || ${#missing_cask[@]} -gt 0 ]]; then
        echo -e "\n${BOLD}Missing Packages:${RESET}"
        
        if [[ ${#missing_brew[@]} -gt 0 ]]; then
            __print_warning "Missing brew formulas (${#missing_brew[@]}):"
            printf "  - %s\n" "${missing_brew[@]}"
        fi
        
        if [[ ${#missing_cask[@]} -gt 0 ]]; then
            __print_warning "Missing casks (${#missing_cask[@]}):"
            printf "  - %s\n" "${missing_cask[@]}"
        fi
        
        echo ""
        __print_info "Run '${SCRIPT_NAME} init' to install missing packages"
    else
        __print_success "All packages are installed!"
    fi
}

cmd_package() {
    local subcommand="${1:-list}"
    shift || true

    local argument
    for argument in "$@"; do
        if [[ "$argument" == "-h" || "$argument" == "--help" ]]; then
            __print_package_subcommand_help "$subcommand"
            return
        fi
    done

    case "$subcommand" in
        add)
            cmd_package_add "$@"
            ;;
        remove)
            cmd_package_remove "$@"
            ;;
        update)
            cmd_package_update "$@"
            ;;
        list)
            cmd_package_list "$@"
            ;;
        -h|--help|help)
            cmd_package_help
            ;;
        *)
            __print_error "Unknown package subcommand: $subcommand"
            __print_info "Run '${SCRIPT_NAME} package help' for usage"
            return 1
            ;;
    esac
}

cmd_package_add() {
    local package_name="${1:-}"
    local package_type="${2:-auto}"
    local bundle_file="${3:-base}"

    if [[ -z "$package_name" ]]; then
        __print_error "Package name required"
        __print_info "Usage: ${SCRIPT_NAME} package add <package-name> [brew|cask] [base|work]"
        return 1
    fi
    if [[ $# -gt 3 ]]; then
        __print_error "Too many arguments for package add"
        return 1
    fi

    local target_bundle
    case "$bundle_file" in
        base) target_bundle="${PACKAGES_DIR}/bundle" ;;
        work) target_bundle="${PACKAGES_DIR}/bundle.work" ;;
        *)
            __print_error "Bundle must be 'base' or 'work'"
            return 1
            ;;
    esac
    
    # Auto-detect package type if not specified
    if [[ "$package_type" == "auto" ]]; then
        __print_info "Detecting package type..."
        # Use brew info --json for more precise package detection
        if brew info --json=v2 --formula "$package_name" >/dev/null 2>&1; then
            package_type="brew"
        elif brew info --json=v2 --cask "$package_name" >/dev/null 2>&1; then
            package_type="cask"
        else
            __print_warning "Package '$package_name' not found in either formulas or casks"
            __print_info "Defaulting to brew formula. Use 'brew' or 'cask' to specify explicitly"
            package_type="brew"
        fi
    fi
    
    # Validate package type and bundle policy
    if [[ "$package_type" != "brew" && "$package_type" != "cask" ]]; then
        __print_error "Package type must be 'brew' or 'cask'"
        return 1
    fi
    if [[ "$package_type" == "cask" && "$bundle_file" == "work" ]]; then
        __print_error "Casks must be added to the base bundle"
        return 1
    fi

    # Check if package already exists in bundle
    local package_line="${package_type} \"${package_name}\""
    if grep -Fqx -- "$package_line" "$target_bundle" 2>/dev/null; then
        __print_warning "Package '$package_name' already exists in $(basename "$target_bundle")"
        return 0
    fi
    
    __print_header "Adding $package_type package: $package_name"
    
    # Install the package first
    __print_info "Installing package..."
    if __brew_install "$package_type" "$package_name"; then
        __print_success "Package installed successfully"
    else
        __print_error "Failed to install package"
        return 1
    fi
    
    # Add to bundle file
    __print_info "Adding to bundle file..."
    if [[ ! -f "$target_bundle" ]]; then
        __print_warning "Bundle file doesn't exist, creating: $target_bundle"
        mkdir -p "$(dirname "$target_bundle")"
        touch "$target_bundle"
    fi
    
    # Find the right place to insert the package (keep them sorted)
    local temp_file
    temp_file=$(mktemp)
    local inserted=false
    
    local parsed existing_type existing_package
    while IFS= read -r line || [[ -n "$line" ]]; do
        parsed=$(__parse_brewfile_entry "$line") || parsed=""
        if [[ -n "$parsed" && "$inserted" == false ]]; then
            IFS=$'\t' read -r existing_type existing_package <<< "$parsed"
            if [[ "$existing_type" == "$package_type" && "$package_name" < "$existing_package" ]] ||
               [[ "$package_type" == "brew" && "$existing_type" == "cask" ]]; then
                echo "$package_line" >> "$temp_file"
                inserted=true
            fi
        fi
        echo "$line" >> "$temp_file"
    done < "$target_bundle"
    
    # If we haven't inserted yet, add at the end
    if [[ "$inserted" == false ]]; then
        echo "$package_line" >> "$temp_file"
    fi
    
    # Replace the original file
    mv "$temp_file" "$target_bundle"
    
    __print_success "Added '$package_name' to $(basename "$target_bundle")"
    __print_info "Package will be included in future installations"
}

cmd_package_remove() {
    local package_name="${1:-}"
    local bundle_file="${2:-auto}"

    if [[ -z "$package_name" ]]; then
        __print_error "Package name required"
        __print_info "Usage: ${SCRIPT_NAME} package remove <package-name> [base|work|auto]"
        return 1
    fi
    if [[ $# -gt 2 ]]; then
        __print_error "Too many arguments for package remove"
        return 1
    fi

    # Escape regex metacharacters in package name
    local escaped_package
    # shellcheck disable=SC2016 # Single quotes intentional - \& is sed backreference
    escaped_package=$(printf '%s' "$package_name" | sed 's/[.[\*^$()+?{|\\]/\\&/g')
    
    __print_header "Removing package: $package_name"
    
    # Determine which bundle files to check
    local bundle_files=()
    case "$bundle_file" in
        work) bundle_files=("${PACKAGES_DIR}/bundle.work") ;;
        base) bundle_files=("${PACKAGES_DIR}/bundle") ;;
        auto) bundle_files=("${PACKAGES_DIR}/bundle" "${PACKAGES_DIR}/bundle.work") ;;
        *)
            __print_error "Bundle must be 'base', 'work', or 'auto'"
            return 1
            ;;
    esac
    
    local found=false
    local package_type=""
    
    # Find and remove from bundle files
    for target_bundle in "${bundle_files[@]}"; do
        if [[ ! -f "$target_bundle" ]]; then
            continue
        fi
        
        # Check if package exists
        if grep -q "^\\(brew\\|cask\\)[[:space:]]*\"${escaped_package}\"" "$target_bundle"; then
            found=true

            # Determine package type
            if grep -q "^brew[[:space:]]*\"${escaped_package}\"" "$target_bundle"; then
                package_type="formula"
            else
                package_type="cask"
            fi

            # Remove from bundle file
            __print_info "Removing from $(basename "$target_bundle")..."
            local temp_file grep_status
            temp_file=$(mktemp)
            if grep -v "^\\(brew\\|cask\\)[[:space:]]*\"${escaped_package}\"" "$target_bundle" > "$temp_file"; then
                true
            else
                grep_status=$?
                if [[ $grep_status -ne 1 ]]; then
                    rm -f "$temp_file"
                    __print_error "Failed to update $(basename "$target_bundle")"
                    return 1
                fi
            fi
            mv "$temp_file" "$target_bundle"
            
            __print_success "Removed '$package_name' from $(basename "$target_bundle")"
        fi
    done
    
    if [[ "$found" == false ]]; then
        __print_warning "Package '$package_name' not found in any bundle files"
        return 0
    fi
    
    # Ask if user wants to uninstall the actual package
    if __confirm "Uninstall '$package_name' from system?" "n"; then
        __print_info "Uninstalling package..."
        if [[ "$package_type" == "cask" ]]; then
            if brew uninstall --cask "$package_name"; then
                __print_success "Package uninstalled successfully"
            else
                __print_warning "Failed to uninstall package (it may have dependencies)"
            fi
        else
            if brew uninstall "$package_name"; then
                __print_success "Package uninstalled successfully"
            else
                __print_warning "Failed to uninstall package (it may have dependencies)"
            fi
        fi
    else
        __print_info "Package removed from bundle but left installed on system"
    fi
}

cmd_package_update() {
    local package_name="${1:-all}"
    local bundle_file="${2:-all}"

    if [[ $# -gt 2 ]]; then
        __print_error "Too many arguments for package update"
        return 1
    fi
    case "$bundle_file" in
        all|base|work) ;;
        *)
            __print_error "Bundle must be 'all', 'base', or 'work'"
            return 1
            ;;
    esac

    __print_header "Updating packages"

    local installed_formulas installed_casks outdated_formulas outdated_casks

    if [[ "$package_name" != "all" ]]; then
        if ! installed_formulas=$(brew list --formula 2>/dev/null); then
            __print_error "Failed to list installed Homebrew formulas"
            return 1
        fi
        if ! installed_casks=$(brew list --cask 2>/dev/null); then
            __print_error "Failed to list installed Homebrew casks"
            return 1
        fi
        if ! outdated_formulas=$(brew outdated --formula --quiet 2>/dev/null); then
            __print_error "Failed to check outdated Homebrew formulas"
            return 1
        fi
        if ! outdated_casks=$(brew outdated --cask --quiet 2>/dev/null); then
            __print_error "Failed to check outdated Homebrew casks"
            return 1
        fi

        local package_type outdated_packages target_bundle
        if __list_contains "$package_name" "$installed_formulas"; then
            package_type="brew"
            outdated_packages="$outdated_formulas"
        elif __list_contains "$package_name" "$installed_casks"; then
            package_type="cask"
            outdated_packages="$outdated_casks"
        else
            __print_error "Package '$package_name' is not installed"
            return 1
        fi

        if [[ "$bundle_file" != "all" ]]; then
            target_bundle="${PACKAGES_DIR}/bundle"
            [[ "$bundle_file" == "work" ]] && target_bundle="${PACKAGES_DIR}/bundle.work"
            if [[ "$bundle_file" == "work" && -f "$target_bundle" ]]; then
                __validate_work_brewfile "$target_bundle" || return 1
            fi
            if [[ ! -f "$target_bundle" ]] || ! grep -Fqx -- "${package_type} \"${package_name}\"" "$target_bundle"; then
                __print_error "Package '$package_name' is not in the $bundle_file bundle"
                return 1
            fi
        fi

        if ! __list_contains "$package_name" "$outdated_packages"; then
            __print_info "$package_name is already up to date"
            return 0
        fi

        __print_info "Updating $package_type package: $package_name"
        if __brew_upgrade "$package_type" "$package_name"; then
            __print_success "Updated $package_name successfully"
            return 0
        fi

        __print_error "Failed to update $package_name"
        return 1
    fi

    __print_info "Updating Homebrew..."
    if ! brew update; then
        __print_error "Failed to update Homebrew"
        return 1
    fi
    __print_success "Homebrew updated successfully"

    if [[ "$bundle_file" == "all" ]]; then
        local all_update_failed=false
        __print_info "Upgrading all installed packages..."

        if brew upgrade; then
            __print_success "Brew formulas updated"
        else
            __print_error "Some brew formulas failed to update"
            all_update_failed=true
        fi

        if brew upgrade --cask; then
            __print_success "Casks updated"
        else
            __print_error "Some casks failed to update"
            all_update_failed=true
        fi

        if __confirm "Clean up old versions?" "y"; then
            __print_info "Cleaning up old package versions..."
            brew cleanup
            __print_success "Cleanup completed"
        fi

        if [[ "$all_update_failed" == true ]]; then
            return 1
        fi
        return 0
    fi

    if ! installed_formulas=$(brew list --formula 2>/dev/null); then
        __print_error "Failed to refresh installed Homebrew formulas"
        return 1
    fi
    if ! installed_casks=$(brew list --cask 2>/dev/null); then
        __print_error "Failed to refresh installed Homebrew casks"
        return 1
    fi
    if ! outdated_formulas=$(brew outdated --formula --quiet 2>/dev/null); then
        __print_error "Failed to refresh outdated Homebrew formulas"
        return 1
    fi
    if ! outdated_casks=$(brew outdated --cask --quiet 2>/dev/null); then
        __print_error "Failed to refresh outdated Homebrew casks"
        return 1
    fi

    local target_bundle="${PACKAGES_DIR}/bundle"
    [[ "$bundle_file" == "work" ]] && target_bundle="${PACKAGES_DIR}/bundle.work"
    if [[ ! -f "$target_bundle" ]]; then
        __print_error "Bundle file not found: $(basename "$target_bundle")"
        return 1
    fi
    if [[ "$bundle_file" == "work" ]]; then
        __validate_work_brewfile "$target_bundle" || return 1
    fi

    __print_info "Updating packages from ${bundle_file} bundle..."
    local updated_packages=()
    local failed_packages=()
    local line parsed package_type current_packages outdated_packages package_name

    while IFS= read -r line; do
        parsed=$(__parse_brewfile_entry "$line") || continue
        IFS=$'\t' read -r package_type package_name <<< "$parsed"

        if [[ "$package_type" == "brew" ]]; then
            current_packages="$installed_formulas"
            outdated_packages="$outdated_formulas"
        else
            current_packages="$installed_casks"
            outdated_packages="$outdated_casks"
        fi

        if ! __list_contains "$package_name" "$current_packages"; then
            __print_warning "$package_type package $package_name is not installed, skipping"
            continue
        fi
        if ! __list_contains "$package_name" "$outdated_packages"; then
            __print_info "$package_name is already up to date"
            continue
        fi

        __print_info "Updating $package_type package: $package_name"
        if __brew_upgrade "$package_type" "$package_name"; then
            updated_packages+=("$package_name ($package_type)")
        else
            __print_error "Failed to update $package_name"
            failed_packages+=("$package_name ($package_type)")
        fi
    done < "$target_bundle"

    if [[ ${#updated_packages[@]} -gt 0 ]]; then
        __print_success "Updated ${#updated_packages[@]} packages:"
        printf "  - %s\n" "${updated_packages[@]}"
    elif [[ ${#failed_packages[@]} -eq 0 ]]; then
        __print_info "All packages are already up to date"
    fi

    if [[ ${#failed_packages[@]} -gt 0 ]]; then
        __print_error "Failed to update ${#failed_packages[@]} packages:"
        printf "  - %s\n" "${failed_packages[@]}"
    fi

    if __confirm "Clean up old versions?" "y"; then
        __print_info "Cleaning up old package versions..."
        brew cleanup
        __print_success "Cleanup completed"
    fi

    if [[ ${#failed_packages[@]} -gt 0 ]]; then
        return 1
    fi
    return 0
}

cmd_package_list() {
    local bundle_file="${1:-all}"

    if [[ $# -gt 1 ]]; then
        __print_error "Too many arguments for package list"
        return 1
    fi
    case "$bundle_file" in
        all|base|work) ;;
        *)
            __print_error "Bundle must be 'all', 'base', or 'work'"
            return 1
            ;;
    esac

    __print_header "Listing packages"

    # Cache brew list output once to avoid SIGPIPE issues with pipefail
    local installed_formulas
    local installed_casks
    if ! installed_formulas=$(brew list --formula 2>/dev/null); then
        __print_error "Failed to list installed Homebrew formulas"
        return 1
    fi
    if ! installed_casks=$(brew list --cask 2>/dev/null); then
        __print_error "Failed to list installed Homebrew casks"
        return 1
    fi

    # Determine which bundle files to list
    local bundle_files=()
    local bundle_names=()

    case "$bundle_file" in
        work)
            bundle_files=("${PACKAGES_DIR}/bundle.work")
            bundle_names=("work")
            ;;
        base)
            bundle_files=("${PACKAGES_DIR}/bundle")
            bundle_names=("base")
            ;;
        all)
            bundle_files=("${PACKAGES_DIR}/bundle" "${PACKAGES_DIR}/bundle.work")
            bundle_names=("base" "work")
            ;;
    esac

    for i in "${!bundle_files[@]}"; do
        local target_bundle="${bundle_files[$i]}"
        local bundle_name="${bundle_names[$i]}"

        if [[ ! -f "$target_bundle" ]]; then
            if [[ "$bundle_file" != "all" ]]; then
                __print_error "Bundle file not found: $(basename "$target_bundle")"
                return 1
            fi
            continue
        fi
        if [[ "$bundle_name" == "work" ]]; then
            __validate_work_brewfile "$target_bundle" || return 1
        fi

        echo -e "\n${BOLD}${bundle_name^} packages ($(basename "$target_bundle")):${RESET}"

        local brew_packages=()
        local cask_packages=()
        local line parsed package_type package_name

        while IFS= read -r line; do
            parsed=$(__parse_brewfile_entry "$line") || continue
            IFS=$'\t' read -r package_type package_name <<< "$parsed"
            if [[ "$package_type" == "brew" ]]; then
                brew_packages+=("$package_name")
            else
                cask_packages+=("$package_name")
            fi
        done < "$target_bundle"

        if [[ ${#brew_packages[@]} -gt 0 ]]; then
            echo -e "  ${BOLD}Brew formulas (${#brew_packages[@]}):${RESET}"
            for package in "${brew_packages[@]}"; do
                if __list_contains "$package" "$installed_formulas"; then
                    __print_success "    $package"
                else
                    __print_error "    $package (not installed)"
                fi
            done
        fi

        if [[ ${#cask_packages[@]} -gt 0 ]]; then
            echo -e "  ${BOLD}Casks (${#cask_packages[@]}):${RESET}"
            for package in "${cask_packages[@]}"; do
                if __list_contains "$package" "$installed_casks"; then
                    __print_success "    $package"
                else
                    __print_error "    $package (not installed)"
                fi
            done
        fi

        if [[ ${#brew_packages[@]} -eq 0 && ${#cask_packages[@]} -eq 0 ]]; then
            __print_info "  No packages found"
        fi
    done
}

__print_package_subcommand_help() {
    local subcommand="$1"

    case "$subcommand" in
        add)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} package add NAME [brew|cask] [base|work]"
            echo ""
            echo "Add and install a package. Work bundles accept formulas only."
            ;;
        remove)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} package remove NAME [base|work|auto]"
            echo ""
            echo "Remove a package from one or both bundles and optionally uninstall it."
            ;;
        update)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} package update [NAME|all] [all|base|work]"
            echo ""
            echo "Update one package, every installed package, or packages in one bundle."
            ;;
        list)
            echo -e "${BOLD}USAGE:${RESET}\n    ${SCRIPT_NAME} package list [all|base|work]"
            echo ""
            echo "List package declarations and their installation status."
            ;;
        help)
            cmd_package_help
            ;;
        *)
            __print_error "Unknown package subcommand: $subcommand"
            return 1
            ;;
    esac
}

